version: 2
ethernets:
  nat0:
    match:
      macaddress: "00:50:56:33:00:01"
    set-name: eth0
    dhcp4: false
    addresses:
      - 192.168.126.100/24
    routes:
      - to: default
        via: 192.168.126.2
    nameservers:
      addresses:
        - 192.168.126.2
        - 8.8.8.8
  bridge0:
    match:
      macaddress: "00:50:56:33:00:02"
    set-name: eth1
    dhcp4: true
    dhcp4-overrides:
      use-routes: false
      use-dns: false
    optional: true
