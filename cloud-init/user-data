#cloud-config
hostname: srv
fqdn: srv.elhadji.sn
manage_etc_hosts: true
timezone: Africa/Dakar

users:
  - name: root
    lock_passwd: false
    plain_text_passwd: "Passer@2026"
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKr4eZF0uXaGYuY8GxiZ8oy69riQxwO+/E7HE6ex62uW admin@elhadji.sn
  - name: ubuntu
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: users, admin, sudo
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: "Passer@2026"
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKr4eZF0uXaGYuY8GxiZ8oy69riQxwO+/E7HE6ex62uW admin@elhadji.sn

ssh_pwauth: true
disable_root: false

growpart:
  mode: auto
  devices: ['/']
  ignore_growroot_disabled: false
resize_rootfs: true

runcmd:
  - sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
  - sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
  - systemctl restart ssh || systemctl restart sshd
